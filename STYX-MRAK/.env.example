# Copy to .env and fill in. NEVER commit .env.

# --- Discord ---------------------------------------------------------------
# Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Server (guild) ID of STYX Rivals
GUILD_ID=

# Role IDs (Server Settings -> Roles -> right-click role -> Copy Role ID)
ROLE_WARDEN=
ROLE_KERBEROS=
ROLE_CHARON=
ROLE_STYX=
ROLE_NIX=

# Channel IDs (right-click channel -> Copy Channel ID; needs Developer Mode)
CHANNEL_APPLY=
CHANNEL_ROSTER=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_STAFF=
CHANNEL_LOGS=

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite://data/styx.db

# --- Behaviour -------------------------------------------------------------
# Let Charon accept/reject applications (default: only Kerberos and Warden).
CHARON_CAN_DECIDE=false
# Needs the MESSAGE CONTENT privileged intent enabled in the Developer Portal.
AUTOMOD_ENABLED=false

# --- Rivals intel feed (X API v2, needs a bearer token) --------------------
FEED_ENABLED=false
FEED_INTERVAL_SECONDS=300
FEED_X_BEARER_TOKEN=
FEED_X_USERNAME=NosniyGames

# --- Logging ---------------------------------------------------------------
# Development: info    Production: info,sqlx=warn
RUST_LOG=info,sqlx=warn
